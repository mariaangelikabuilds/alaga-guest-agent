# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: an n8n webhook the agent posts real workflow triggers to.
# Without it, triggers are logged locally and the agent still runs end to end.
N8N_OPS_WEBHOOK=
# Shared secret for that webhook, sent as the x-guest-ops-key header. Must match
# the "Guest Ops gate" credential in n8n or the webhook answers 403.
N8N_OPS_KEY=
